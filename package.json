{
  "name": "@grepture/cli",
  "version": "0.1.0",
  "description": "AI security scanner for developers — Scan for PII, secrets, prompt injection, and unsafe AI SDK usage.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Grepture <hello@grepture.com> (https://grepture.com)",
  "homepage": "https://github.com/grepture/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/grepture/cli.git"
  },
  "bugs": {
    "url": "https://github.com/grepture/cli/issues"
  },
  "keywords": [
    "security",
    "ai",
    "llm",
    "pii",
    "secrets",
    "scanner",
    "linter",
    "sast",
    "semgrep",
    "prompt-injection",
